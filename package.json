{
  "name": "orbit-lens-v1",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "data:gazetteer": "node scripts/build-gazetteer.mjs && node scripts/enrich-bboxes.mjs",
    "data:boundaries": "node scripts/fetch-boundaries.mjs",
    "data:land": "node scripts/build-land.mjs",
    "data:gdacs": "node scripts/fetch-gdacs.mjs",
    "nisar": "cd workers/nisar && .venv/bin/python server.py",
    "nisar:setup": "python3 -m venv workers/nisar/.venv && workers/nisar/.venv/bin/python -m pip install -r workers/nisar/requirements.txt",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "test:setup": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "flatbush": "^4.7.0",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.17.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
